
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spring</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
}

.scene {
    width: 100%;
    height: 100vh;
    min-height: 500px;
    position: relative;
    overflow: hidden;
    background: #acd2df;
}

h1 {
    position: absolute;
    top: 8%;
    left: 7%;
    z-index: 5;
    margin: 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 700;
    color: #344a45;
}

.sun {
    position: absolute;
    top: 18%;
    right: 15%;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: #f5dc91;
    display: block;
    z-index: 5;
}

.field {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 43%;
    background: #80b66e;
    border-radius: 50% 50% 0 0 / 10% 10% 0 0;
}

.grass {
    position: absolute;
    bottom: 35%;
    left: 0;
    width: 100%;
    height: 18%;
    display: flex;
    justify-content: space-around;
    align-items: end;
}

.grass span {
    width: 3px;
    height: 40px;
    background: #4e8b50;
    border-radius: 100% 0;
    transform: rotate(-15deg);
}

.grass span:nth-child(2n) {
    height: 55px;
    transform: rotate(15deg);
}

.grass span:nth-child(3n) {
    height: 28px;
}

.flower {
    position: absolute;
    bottom: 38%;
    left: 15%;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #f4b7c8;
    box-shadow:
        0 -12px 0 -2px #f4b7c8,
        0 12px 0 -2px #f4b7c8,
        12px 0 0 -2px #f4b7c8,
        -12px 0 0 -2px #f4b7c8;
}

.flower::after {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8b94f;
    top: 5px;
    left: 5px;
}

.flower.two {
    left: 30%;
    bottom: 43%;
    transform: scale(1.2);
    background: #fff0dc;
    box-shadow:
        0 -12px 0 -2px #fff0dc,
        0 12px 0 -2px #fff0dc,
        12px 0 0 -2px #fff0dc,
        -12px 0 0 -2px #fff0dc;
}

.flower.three {
    left: 48%;
    bottom: 36%;
    transform: scale(.9);
}

.flower.four {
    left: 65%;
    bottom: 44%;
    transform: scale(1.3);
    background: #fff0dc;
    box-shadow:
        0 -12px 0 -2px #fff0dc,
        0 12px 0 -2px #fff0dc,
        12px 0 0 -2px #fff0dc,
        -12px 0 0 -2px #fff0dc;
}

.flower.five {
    left: 83%;
    bottom: 39%;
    transform: scale(1.1);
}

</style>
</head>

<body>
<main class="scene">

    <h1>What Does Spring Look Like?</h1>

    <a href="index.html" class="sun"></a>

    <div class="field"></div>

    <div class="grass">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
    </div>

    <div class="flower"></div>
    <div class="flower two"></div>
    <div class="flower three"></div>
    <div class="flower four"></div>
    <div class="flower five"></div>

</main>
</body>
</html>
